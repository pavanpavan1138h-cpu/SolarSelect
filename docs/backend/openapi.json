  "components": {
    "schemas": {
      "BatchRequest": {
        "properties": {
          "rows": {
            "items": {
              "$ref": "#/components/schemas/HistoricalRequest"
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Rows",
            "description": "All-or-nothing validation; errors locate rows by zero-based index."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "rows"
        ],
        "title": "BatchRequest"
      },
      "BatchResult": {
        "properties": {
          "results": {
            "items": {
              "$ref": "#/components/schemas/PredictionResult"
            },
            "type": "array",
            "title": "Results"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "results",
          "request_id"
        ],
        "title": "BatchResult"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "details": {
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody"
      },
      "ErrorEnvelope": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "error",
          "request_id"
        ],
        "title": "ErrorEnvelope"
      },
      "HistoricalFeatures": {
        "properties": {
          "kWp": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Kwp"
          },
          "lat": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Lat"
          },
          "Lon": {
            "type": "number",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Lon"
          },
          "day_of_year": {
            "type": "number",
            "maximum": 366.0,
            "minimum": 1.0,
            "title": "Day Of Year"
          },
          "month": {
            "type": "number",
            "maximum": 12.0,
            "minimum": 1.0,
            "title": "Month"
          },
          "day_of_week": {
            "type": "number",
            "maximum": 6.0,
            "minimum": 0.0,
            "title": "Day Of Week"
          },
          "is_weekend": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Is Weekend"
          },
          "sin_doy": {
            "type": "number",
            "title": "Sin Doy"
          },
          "cos_doy": {
            "type": "number",
            "title": "Cos Doy"
          },
          "sin_month": {
            "type": "number",
            "title": "Sin Month"
          },
          "cos_month": {
            "type": "number",
            "title": "Cos Month"
          },
          "solar_declination_deg": {
            "type": "number",
            "title": "Solar Declination Deg"
          },
          "solar_noon_elevation_deg": {
            "type": "number",
            "title": "Solar Noon Elevation Deg"
          },
          "solar_noon_zenith_deg": {
            "type": "number",
            "title": "Solar Noon Zenith Deg"
          },
          "daylight_hours": {
            "type": "number",
            "title": "Daylight Hours"
          },
          "extraterrestrial_radiation_h0": {
            "type": "number",
            "title": "Extraterrestrial Radiation H0"
          },
          "has_valid_lag1": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Has Valid Lag1"
          },
          "lag1_daily_yield": {
            "type": "number",
            "title": "Lag1 Daily Yield"
          },
          "lag2_daily_yield": {
            "type": "number",
            "title": "Lag2 Daily Yield"
          },
          "lag7_daily_yield": {
            "type": "number",
            "title": "Lag7 Daily Yield"
          },
          "rolling_mean_7d_yield": {
            "type": "number",
            "title": "Rolling Mean 7D Yield"
          },
          "rolling_std_7d_yield": {
            "type": "number",
            "title": "Rolling Std 7D Yield"
          },
          "rolling_mean_14d_yield": {
            "type": "number",
            "title": "Rolling Mean 14D Yield"
          },
          "rolling_mean_30d_yield": {
            "type": "number",
            "title": "Rolling Mean 30D Yield"
          },
          "lag1_temp_mean": {
            "type": "number",
            "title": "Lag1 Temp Mean"
          },
          "lag1_temp_max": {
            "type": "number",
            "title": "Lag1 Temp Max"
          },
          "lag1_temp_min": {
            "type": "number",
            "title": "Lag1 Temp Min"
          },
          "lag1_temp_range": {
            "type": "number",
            "title": "Lag1 Temp Range"
          },
          "lag1_rh_mean": {
            "type": "number",
            "title": "Lag1 Rh Mean"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kWp",
          "lat",
          "Lon",
          "day_of_year",
          "month",
          "day_of_week",
          "is_weekend",
          "sin_doy",
          "cos_doy",
          "sin_month",
          "cos_month",
          "solar_declination_deg",
          "solar_noon_elevation_deg",
          "solar_noon_zenith_deg",
          "daylight_hours",
          "extraterrestrial_radiation_h0",
          "has_valid_lag1",
          "lag1_daily_yield",
          "lag2_daily_yield",
          "lag7_daily_yield",
          "rolling_mean_7d_yield",
          "rolling_std_7d_yield",
          "rolling_mean_14d_yield",
          "rolling_mean_30d_yield",
          "lag1_temp_mean",
          "lag1_temp_max",
          "lag1_temp_min",
          "lag1_temp_range",
          "lag1_rh_mean"
        ],
        "title": "HistoricalFeatures"
      },
      "HistoricalRequest": {
        "properties": {
          "scenario": {
            "type": "string",
            "const": "historical_site_day",
            "title": "Scenario"
          },
          "features": {
            "$ref": "#/components/schemas/HistoricalFeatures"
          },
          "model_variant": {
            "$ref": "#/components/schemas/ModelVariant",
            "default": "primary_extra_trees"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "scenario",
          "features"
        ],
        "title": "HistoricalRequest"
      },
      "ModelVariant": {
        "type": "string",
        "enum": [
          "primary_extra_trees",
          "fallback_blend_50_50"
        ],
        "title": "ModelVariant",
        "description": "Authorized model variant for Phase 5 Peer Cohort inference."
      },
